# Only needed for --model claude. The mock model, the tests and the demo need none of this.
ANTHROPIC_API_KEY=

# Model used by the lead and the workers (default: claude-sonnet-5-5)
AGENT_DISPATCHER_MODEL=claude-sonnet-5-5

# Optional: a different model for the verifier. Empty means same as above.
AGENT_DISPATCHER_VERIFIER_MODEL=

# Optional: low | medium | high | xhigh | max. Empty means the API default.
AGENT_DISPATCHER_EFFORT=

# Optional: set to "default" to opt in to server side refusal fallbacks (beta).
AGENT_DISPATCHER_FALLBACKS=
